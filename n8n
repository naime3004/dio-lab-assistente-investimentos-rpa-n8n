        "jsCode": "return $input.all().map((item, index) => {\n  // Pega os dados originais do cliente pelo índice do nó 'Trata dados para LLM'\n  const clienteOriginal = $(\"Trata dados para LLM\").all()[index]?.json || {};\n  \n  // Extrai o texto gerado pela LLM\n  const rawText = item.json.output?.[0]?.content?.[0]?.text || \"\";\n  const textoLimpo = rawText.trim();\n  const textoHTML = textoLimpo.replace(/\\n/g, '<br>');\n\n  return {\n    json: {\n      email_to: clienteOriginal.email_to,\n      nome: clienteOriginal.nome,\n      perfil: clienteOriginal.perfil,\n      assunto_email: `Recomendação de Investimento - Perfil ${clienteOriginal.perfil}`,\n      mensagem_texto: textoLimpo,\n      mensagem_html: `<div style=\"font-family: Arial, sans-serif; font-size: 14px; line-height: 1.6; color: #333333;\">${textoHTML}</div>`\n    }\n  };\n});"
