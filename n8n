    {
      "parameters": {
        "jsCode": "// 1. Obtém os dados que vieram do nó do CSV (Lê e trata arquivo CSV)\n// e os dados dos clientes que vieram do Webhook\nconst produtosCSV = $(\"Lê e trata arquivo CSV\").all().map(item => item.json);\nconst inputWebhook = $input.first().json;\nconst clientes = inputWebhook.body?.clientes || [];\n\n// Função auxiliar para converter valores monetários em string para número\nfunction parseBRL(valor) {\n  if (!valor) return 0;\n  const s = String(valor)\n    .replace(\"R$\", \"\")\n    .replace(/\\./g, \"\")\n    .replace(\",\", \".\")\n    .replace(/[^\\d.]/g, \"\")\n    .trim();\n  const n = Number(s);\n  return Number.isFinite(n) ? n : 0;\n}\n\n// Mapeia cada cliente relacionando com o produto de investimento do seu respectivo perfil\nreturn clientes.map(c => {\n  const saldoNum = parseBRL(c.saldo);\n\n  // Busca o produto correspondente ao perfil do cliente na lista do CSV\n  const recomendacaoPerfil = produtosCSV.find(p => \n    p.perfil?.toLowerCase() === c.perfil?.toLowerCase()\n  ) || {};\n\n  const produtoNome = recomendacaoPerfil.produto || inputWebhook.produto || \"Produto de Investimento\";\n  const minimoVal = recomendacaoPerfil.minimo ?? inputWebhook.minimo ?? 0;\n  const rentabilidadeVal = recomendacaoPerfil.rentabilidade || inputWebhook.rentabilidade || \"N/A\";\n\n  // Verifica se o saldo atende ao valor mínimo\n  const motivoStatus = saldoNum >= minimoVal ? \"saldo_ok\" : \"saldo_insuficiente\";\n\n  return {\n    json: {\n      email_to: c.email,\n      nome: c.nome,\n      perfil: c.perfil,\n      saldo_texto: c.saldo,\n      saldo_num: saldoNum,\n      recomendacao: {\n        perfil: c.perfil,\n        produto: produtoNome,\n        minimo: minimoVal,\n        rentabilidade: rentabilidadeVal\n      },\n      motivo: motivoStatus,\n      mensagem_base: `${c.nome}, indo direto ao ponto: para o perfil ${c.perfil}, **${produtoNome}** (mínimo R$ ${minimoVal}). Você tem ${c.saldo}, então dá pra aplicar. Rentabilidade: ${rentabilidadeVal}.`,\n      copy_rules: {\n        idioma: \"pt-BR\",\n        tom: \"amigável e profissional\",\n        tamanho: \"curto (4-6 linhas)\",\n        evitar: [\n          \"promessas de ganho\",\n          \"garantias\",\n          \"linguagem agressiva\"\n        ]\n      }\n    }\n  };\n});"
      },
