      "parameters": {
        "jsCode": "// Recupera o texto CSV retornado pelo nó HTTP Request\nconst csvText = $(\"HTTP Request\").first().json.data;\n\n// Divide o texto pelas linhas\nconst lines = csvText.trim().split('\\n');\n\n// Extrai os cabeçalhos da primeira linha\nconst headers = lines[0].split(',').map(h => h.trim());\n\n// Processa cada linha de dados\nconst result = lines.slice(1).map(line => {\n  const values = line.split(',').map(v => v.trim());\n  const row = {};\n\n  headers.forEach((header, index) => {\n    let value = values[index];\n\n    // Converte o valor da coluna 'minimo' para tipo numérico\n    if (header === 'minimo') {\n      value = Number(value);\n    }\n\n    row[header] = value;\n  });\n\n  return { json: row };\n});\n\nreturn result;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -288,
        16
